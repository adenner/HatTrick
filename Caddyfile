:80 {
    root * /srv
    file_server
    encode zstd br gzip

    # Vite emits content-hashed filenames for JS/CSS — these are safe to cache forever
    @hashed path_regexp \.[a-f0-9]{8,}\.(js|css|woff2?)$
    header @hashed Cache-Control "public, max-age=31536000, immutable"

    # HTML is the entry point and must always be re-fetched
    @html {
        path *.html
        path /
    }
    header @html Cache-Control "no-cache"

    # SPA fallback: unknown paths serve index.html so browser-side routing works
    try_files {path} /index.html
}
